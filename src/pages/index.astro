---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CredibilityBand from '../components/CredibilityBand.astro';
import { siteConfig } from '../data/siteConfig';

const forwardCards = [
  {
    title: 'Help your team think differently',
    description: 'Build creative confidence and equip cross-functional teams with human-centred problem-solving practices.',
    link: '/services#creative-confidence',
    linkText: 'Explore workshops & sprints'
  },
  {
    title: 'Do research or learn more',
    description: 'Understand stakeholder ecosystems, conduct qualitative research, and frame the real problem before building solutions.',
    link: '/services#research-inquiry',
    linkText: 'Explore research offerings'
  },
  {
    title: 'Something else',
    description: 'Have a bespoke curriculum challenge, an institutional transformation, or an ambiguous strategic crossroad? Let’s talk.',
    link: '/contact',
    linkText: 'Start a conversation'
  }
];
---

<BaseLayout 
  title="Vindhya Umapathy — Design Strategist, Educator, Facilitator"
  description="I help organisations make sense of complexity and create what's next through human-centred design, strategic workshops, and educational innovation."
>
  <!-- 1. Hero Section -->
  <section class="hero-section" aria-label="Introduction">
    <div class="container hero-container">
      <div class="hero-text-block">
        <h1 class="hero-headline">{siteConfig.headline}</h1>
        <p class="hero-subhead">
          [TODO: replace with Vindhya's subhead copy — 10+ years designing systemic, people-centred solutions]
        </p>
      </div>

      <!-- Real Photo Placeholder (Replacing generic stock 3D render) -->
      <div class="hero-photo-placeholder" role="region" aria-label="Photo placeholder">
        <p class="placeholder-label">[Photo placeholder: Vindhya facilitating, teaching, or at CAUSE — awaiting client asset]</p>
      </div>
    </div>
  </section>

  <!-- 2. Intro Block: Bio & Credentials -->
  <section class="section intro-section" aria-label="About Vindhya Umapathy">
    <div class="container intro-container">
      <div class="intro-grid">
        <!-- Portrait Photo Column -->
        <div class="intro-photo-wrapper">
          <div class="photo-frame">
            <img 
              src="/images/vindhya-portrait.webp" 
              alt="Portrait of Vindhya Umapathy, Design Strategist, Educator, Facilitator" 
              width="500" 
              height="500" 
              class="portrait-img" 
              loading="lazy" 
              decoding="async" 
            />
          </div>
          <div class="photo-caption">
            <span class="caption-name">{siteConfig.siteName}</span>
            <span class="caption-role">{siteConfig.tagline}</span>
          </div>
        </div>

        <!-- Bio & Narrative Column -->
        <div class="intro-content">
          <h2 class="intro-heading">Vindhya Umapathy — Design Strategist, Educator, Facilitator</h2>
          
          <div class="intro-body">
            <p>
              I am a design strategist, educator, and facilitator with over a decade of practice at the intersection of human behaviour, systems thinking, and institutional learning.
            </p>
            <p>
              Having served as the <strong>Design Thinking Lead at CMR University</strong> and earlier as a <strong>Teach For India fellow</strong>, I work with students, educators, and enterprise leadership to navigate ambiguity and design human-centred interventions.
            </p>
            <p>
              Rather than pre-packaged frameworks, I help teams build creative confidence, ask sharper questions, and test their way through complex real-world challenges.
            </p>
          </div>

          <div class="intro-actions">
            <Button href="/about" variant="secondary" size="md">
              Read my journey & background →
            </Button>
            <Button href="/contact" variant="ghost" size="md">
              Get in touch
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. "What are you trying to move forward?" Interactive Card Row -->
  <section class="section section-alt move-forward-section" aria-label="Ways to work together">
    <div class="container">
      <div class="section-header-wrap">
        <h2 class="section-title">What are you trying to move forward?</h2>
        <p class="section-lead">
          Select the focus area that matches your team’s current crossroad:
        </p>
      </div>

      <div class="pathways-grid">
        {forwardCards.map((card) => (
          <a href={card.link} class="pathway-item">
            <div class="pathway-body">
              <h3 class="pathway-title">{card.title}</h3>
              <p class="pathway-desc">{card.description}</p>
            </div>
            <div class="pathway-footer">
              <span class="pathway-cta">{card.linkText}</span>
              <span class="pathway-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Credibility Band: Stats & Partners Footprint -->
  <CredibilityBand headline="10+ years of designing for people, organisations, and systems" />

  <!-- 5. Closing Home Invitation -->
  <section class="section cta-section" aria-label="Start a conversation">
    <div class="container cta-container">
      <div class="cta-inner">
        <h2 class="cta-title">Ready to navigate your team's next chapter?</h2>
        <p class="cta-text">
          Whether you are designing a university curriculum, unsticking a cross-functional squad, or planning a leadership retreat, let's explore how we can collaborate.
        </p>
        <div class="cta-buttons">
          <Button href="/contact" variant="primary" size="lg">
            Start a conversation
          </Button>
          <Button href="/work" variant="secondary" size="lg">
            View case studies
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. Hero Section */
  .hero-section {
    padding-top: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    padding-bottom: clamp(var(--space-10), 2rem + 3vw, var(--space-16));
    background: var(--gradient-ambient-hero);
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-6), 1.5rem + 2vw, var(--space-10));
  }

  .hero-text-block {
    max-width: var(--container-narrow-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-3xl), 2rem + 2.5vw, var(--font-size-4xl));
    line-height: var(--line-height-tight);
    color: var(--color-text-main);
  }

  .hero-subhead {
    font-size: clamp(var(--font-size-base), 1rem + 0.5vw, var(--font-size-lg));
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    max-width: 680px;
    line-height: var(--line-height-relaxed);
  }

  /* Photo Placeholder Box (Clearly marked, content-driven, no stock renders) */
  .hero-photo-placeholder {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 3rem + 3vw, var(--space-16)) var(--space-6);
    background-color: var(--color-surface-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: border-color var(--duration-normal) var(--ease-standard);
  }

  .hero-photo-placeholder:hover {
    border-color: var(--color-accent);
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* 2. Intro Section */
  .intro-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    align-items: center;
  }

  @media (min-width: 860px) {
    .intro-grid {
      grid-template-columns: minmax(280px, 360px) 1fr;
    }
  }

  .intro-photo-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .photo-frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-surface-tint);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-slow) var(--ease-spring),
                box-shadow var(--duration-slow) var(--ease-spring);
  }

  .photo-frame:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: var(--shadow-hover);
  }

  .portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .photo-caption {
    display: flex;
    flex-direction: column;
    padding-left: var(--space-2);
  }

  .caption-name {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    color: var(--color-text-main);
  }

  .caption-role {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .intro-eyebrow {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
  }

  .intro-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.6rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
    line-height: var(--line-height-tight);
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* 3. Move Forward Cards */
  .move-forward-section {
    border-bottom: 1px solid var(--color-border);
  }

  .section-header-wrap {
    max-width: var(--container-narrow-width);
    margin-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .section-lead {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
  }

  .pathways-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 860px) {
    .pathways-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pathway-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-5), 1.25rem + 1vw, var(--space-8));
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-normal) var(--ease-spring),
                box-shadow var(--duration-normal) var(--ease-spring),
                border-color var(--duration-normal) var(--ease-standard),
                background-color var(--duration-normal) var(--ease-standard);
    gap: var(--space-6);
    box-shadow: var(--shadow-subtle), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .pathway-item:hover {
    border-color: var(--color-accent);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
  }

  .pathway-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pathway-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: var(--line-height-snug);
  }

  .pathway-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .pathway-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .pathway-cta {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .pathway-arrow {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .pathway-item:hover .pathway-arrow {
    transform: translateX(6px);
  }

  /* 5. Closing CTA */
  .cta-section {
    background-color: var(--color-bg);
  }

  .cta-container {
    max-width: var(--container-narrow-width);
  }

  .cta-inner {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    text-align: center;
    box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    transition: box-shadow var(--duration-normal) var(--ease-spring);
  }

  .cta-inner:hover {
    box-shadow: var(--shadow-hover);
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .cta-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 540px;
    line-height: var(--line-height-relaxed);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* Mobile Optimizations */
  @media (max-width: 640px) {
    .hero-section {
      padding-top: var(--space-6);
      padding-bottom: var(--space-8);
    }

    .hero-photo-placeholder {
      padding: var(--space-6) var(--space-4);
    }

    .intro-photo-wrapper {
      max-width: 260px;
      margin: 0 auto;
    }

    .intro-actions {
      flex-direction: column;
      width: 100%;
    }

    .intro-actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .pathways-grid {
      gap: var(--space-4);
    }

    .pathway-item {
      padding: var(--space-5) var(--space-4);
      gap: var(--space-4);
    }

    .cta-inner {
      padding: var(--space-6) var(--space-4);
    }

    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .cta-buttons :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
