---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { workshopFormats, mainServices } from '../data/servicesData';
---

<BaseLayout
  title="Ways We Can Work Together — Services"
  description="Explore consulting, executive workshops, and human-centred research offerings tailored for organizations, academic institutions, and cross-functional leadership."
>
  <!-- Page Header -->
  <section class="section page-header-section" aria-label="Services Introduction">
    <div class="container">
      <div class="header-content">
        <h1 class="page-title">Ways we can work together.</h1>
        <p class="page-lead">
          Every organization and curriculum is a distinct human system. Engagements range from rapid problem reframing sprints to multi-week strategic immersions and ongoing advisory.
        </p>
      </div>

      <!-- Quick Jump Anchors -->
      <div class="services-nav-bar">
        <span class="nav-label">Focus areas:</span>
        <div class="nav-chips">
          <a href="#creative-confidence" class="nav-chip">Creative Confidence</a>
          <a href="#workshops" class="nav-chip">Workshops & Sprints</a>
          <a href="#research-inquiry" class="nav-chip">Qualitative Research</a>
          <a href="#org-consulting" class="nav-chip">Org & Curriculum Advisory</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Creative Confidence & Mindset Section -->
  <section id="creative-confidence" class="section section-surface" aria-labelledby="service-1-title">
    <div class="container">
      <div class="service-panel-card">
        <div class="service-left">
          <h2 id="service-1-title" class="service-heading">{mainServices[0].title}</h2>
          <p class="service-lead">{mainServices[0].summary}</p>
          <div class="ideal-fit-box">
            <span class="fit-label">Focus Cohorts:</span>
            <p class="fit-text">{mainServices[0].bestFor}</p>
          </div>
        </div>

        <div class="service-right">
          <p class="service-body">{mainServices[0].description}</p>

          <div class="deliverables-box">
            <h3 class="deliverables-title">Indicative Deliverables</h3>
            <ul class="deliverables-list">
              {mainServices[0].deliverables.map((item) => (
                <li class="deliverable-item">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Workshops: 3 Distinct Format Cards -->
  <section id="workshops" class="section section-alt" aria-labelledby="workshops-title">
    <div class="container">
      <div class="section-intro-clean">
        <h2 id="workshops-title" class="section-title">Workshops & Sprints</h2>
        <p class="section-subtext">
          Tailored for Design Thinking, Collaborative Leadership, and Cross-Disciplinary Communication. Three curated engagement structures:
        </p>
      </div>

      <!-- 3 Format Cards Grid -->
      <div class="workshop-cards-grid">
        {workshopFormats.map((format) => (
          <div class="workshop-card">
            <div class="workshop-card-header">
              <span class="format-duration">{format.duration} · {format.badge}</span>
              <h3 class="workshop-title">{format.title}</h3>
            </div>

            <p class="workshop-desc">{format.description}</p>

            <div class="workshop-section">
              <span class="section-label">Core Focus Areas:</span>
              <ul class="focus-areas-list">
                {format.focusAreas.map((area) => (
                  <li class="focus-area-item">{area}</li>
                ))}
              </ul>
            </div>

            <div class="workshop-audience">
              <span class="section-label">Designed For:</span>
              <p class="audience-text">{format.targetAudience}</p>
            </div>

            <div class="workshop-card-action">
              <Button 
                href={`/contact?interest=${format.id}`} 
                variant="secondary" 
                size="md" 
                class="workshop-action-btn"
              >
                Inquire about this format →
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Qualitative Research Offerings Section -->
  <section id="research-inquiry" class="section section-surface" aria-labelledby="service-2-title">
    <div class="container">
      <div class="service-panel-card">
        <div class="service-left">
          <h2 id="service-2-title" class="service-heading">{mainServices[1].title}</h2>
          <p class="service-lead">{mainServices[1].summary}</p>
          <div class="ideal-fit-box">
            <span class="fit-label">Focus Cohorts:</span>
            <p class="fit-text">{mainServices[1].bestFor}</p>
          </div>
        </div>

        <div class="service-right">
          <p class="service-body">{mainServices[1].description}</p>

          <div class="deliverables-box">
            <h3 class="deliverables-title">Indicative Research Artifacts</h3>
            <ul class="deliverables-list">
              {mainServices[1].deliverables.map((item) => (
                <li class="deliverable-item">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Org Consulting & Curriculum Advisory Section -->
  <section id="org-consulting" class="section section-alt" aria-labelledby="service-3-title">
    <div class="container">
      <div class="service-panel-card">
        <div class="service-left">
          <h2 id="service-3-title" class="service-heading">{mainServices[2].title}</h2>
          <p class="service-lead">{mainServices[2].summary}</p>
          <div class="ideal-fit-box">
            <span class="fit-label">Focus Cohorts:</span>
            <p class="fit-text">{mainServices[2].bestFor}</p>
          </div>
        </div>

        <div class="service-right">
          <p class="service-body">{mainServices[2].description}</p>

          <div class="deliverables-box">
            <h3 class="deliverables-title">Advisory Scope & Artifacts</h3>
            <ul class="deliverables-list">
              {mainServices[2].deliverables.map((item) => (
                <li class="deliverable-item">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Closing CTA -->
  <section class="section cta-section" aria-label="Closing Call to Action">
    <div class="container">
      <div class="services-cta-banner">
        <h2 class="banner-title">Need a tailored format or combination?</h2>
        <p class="banner-desc">
          Most engagements blend workshop facilitation with strategic research or curriculum blueprints. Let’s structure a scope aligned with your team's timeline and goals.
        </p>
        <div class="banner-actions">
          <Button href="/contact" variant="primary" size="lg">
            Start an introductory conversation
          </Button>
          <Button href="/work" variant="secondary" size="lg">
            Review selected work
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page Header */
  .page-header-section {
    padding-top: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    padding-bottom: clamp(var(--space-6), 1.5rem + 2vw, var(--space-10));
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .header-content {
    max-width: var(--container-narrow-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-tag {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-3xl), 2rem + 2vw, var(--font-size-4xl));
    line-height: var(--line-height-tight);
    color: var(--color-text-main);
  }

  .page-lead {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Quick Navigation Chips */
  .services-nav-bar {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .services-nav-bar {
      flex-direction: row;
      align-items: center;
    }
  }

  .nav-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .nav-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .nav-chip {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-main);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    transition: transform var(--duration-fast) var(--ease-standard),
                background-color var(--duration-fast) var(--ease-standard),
                border-color var(--duration-fast) var(--ease-standard),
                color var(--duration-fast) var(--ease-standard),
                box-shadow var(--duration-fast) var(--ease-standard);
  }

  .nav-chip:hover {
    background-color: var(--color-accent-soft);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-subtle);
  }

  /* Service Panel Card (Modern structured card) */
  .service-panel-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-6), 1.5rem + 2vw, var(--space-12));
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: box-shadow var(--duration-normal) var(--ease-spring),
                border-color var(--duration-normal) var(--ease-standard);
  }

  .service-panel-card:hover {
    box-shadow: var(--shadow-hover);
    border-color: rgba(31, 43, 77, 0.2);
  }

  .section-alt .service-panel-card {
    background-color: var(--color-surface);
  }

  @media (min-width: 860px) {
    .service-panel-card {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .service-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .service-category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
  }

  .service-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-xl), 1.5rem + 1vw, var(--font-size-2xl));
    color: var(--color-text-main);
    line-height: var(--line-height-snug);
  }

  .service-lead {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-medium);
  }

  .fit-label {
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
  }

  .fit-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-snug);
  }

  .service-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .service-body {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .deliverables-box {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .deliverables-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    margin-bottom: var(--space-4);
  }

  /* 3 Distinct Workshop Format Cards */
  .workshop-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 900px) {
    .workshop-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }

  .workshop-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-6), 1.5rem + 1.2vw, var(--space-8));
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: transform var(--duration-normal) var(--ease-spring),
                box-shadow var(--duration-normal) var(--ease-spring),
                border-color var(--duration-normal) var(--ease-standard);
    position: relative;
  }

  .workshop-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-5px);
    border-color: var(--color-accent);
  }

  .workshop-card-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .format-duration {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
  }

  .workshop-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: var(--line-height-snug);
  }

  .workshop-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
  }

  .workshop-section {
    margin-bottom: var(--space-4);
  }

  .section-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .deliverables-mini-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .deliverable-mini-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-snug);
  }

  .bullet-icon {
    color: var(--color-accent);
    font-weight: bold;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .workshop-audience {
    margin-top: auto;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-5);
  }

  .audience-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-snug);
  }

  .workshop-card-action {
    margin-top: auto;
    width: 100%;
  }

  .workshop-card-action :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  /* Closing CTA Banner */
  .services-cta-banner {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    text-align: center;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--container-narrow-width);
    margin-left: auto;
    margin-right: auto;
  }

  .banner-eyebrow {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .banner-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 580px;
    line-height: var(--line-height-relaxed);
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  @media (max-width: 640px) {
    .service-panel-card {
      padding: var(--space-5) var(--space-4);
      gap: var(--space-6);
      border-radius: var(--radius-lg);
    }

    .deliverables-box {
      padding: var(--space-4);
    }

    .workshop-card {
      padding: var(--space-5) var(--space-4);
      border-radius: var(--radius-lg);
    }

    .services-cta-banner {
      padding: var(--space-6) var(--space-4);
      border-radius: var(--radius-lg);
      text-align: left;
      align-items: flex-start;
    }

    .banner-actions {
      flex-direction: column;
      width: 100%;
    }

    .banner-actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
