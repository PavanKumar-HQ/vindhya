---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Thinking & Frameworks — Coming Soon"
  description="Essays, design thinking frameworks, and field reflections from Vindhya Umapathy on complexity, education, and human-centred strategy."
  noindex={true}
>
  <section class="section thinking-hero" aria-label="Thinking Coming Soon">
    <div class="container-reading">
      <div class="thinking-card">
        <h1 class="thinking-title">Essays, Frameworks & Field Notes</h1>
        
        <p class="thinking-intro">
          [TODO: replace with Vindhya's copy — forthcoming essays, frameworks, and reflections on design strategy and facilitation]
        </p>

        <div class="thinking-actions">
          <Button href="/" variant="primary" size="md">
            Return to Home
          </Button>
          <Button href="/contact" variant="secondary" size="md">
            Get in touch directly
          </Button>
        </div>

        <!-- Note explaining route state -->
        <div class="editorial-flag">
          <p>
            <em>Launch Note:</em> Per client direction, this route is live for staging review but purposefully unlisted in the navigation bar and marked <code>noindex</code> to avoid search crawler indexing until launch copy is finalized.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thinking-hero {
    padding-top: clamp(var(--space-12), 3rem + 4vw, var(--space-24));
    padding-bottom: clamp(var(--space-12), 3rem + 4vw, var(--space-24));
    background-color: var(--color-bg);
  }

  .thinking-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .thinking-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-4xl));
    color: var(--color-text-main);
    line-height: var(--line-height-tight);
  }

  .thinking-intro {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .thinking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .editorial-flag {
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .editorial-flag code {
    background-color: var(--color-surface-tint);
    padding: 2px 4px;
    border-radius: 3px;
    font-family: var(--font-mono);
  }
</style>
