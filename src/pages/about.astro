---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import JourneySquiggle from '../components/JourneySquiggle.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title="About Vindhya Umapathy — Story & Practice"
  description="Learn more about Vindhya Umapathy, Design Strategist, Educator, and Facilitator with a decade of practice leading design thinking at CMR University and Teach For India."
>
  <!-- Page Header & Story Narrative -->
  <section class="section about-hero-section" aria-label="About Vindhya Umapathy">
    <div class="container">
      <div class="about-grid">
        <!-- Photo Column -->
        <div class="about-photo-col">
          <div class="photo-frame">
            <img 
              src="/images/vindhya-portrait.webp" 
              alt="Portrait of Vindhya Umapathy, Design Strategist, Educator, Facilitator" 
              width="450" 
              height="450" 
              class="about-portrait-img" 
              loading="eager" 
              decoding="async"
            />
          </div>
          <div class="photo-details">
            <span class="detail-name">{siteConfig.siteName}</span>
            <span class="detail-title">{siteConfig.tagline}</span>
            <span class="detail-location">Bengaluru, India · Available Worldwide</span>
          </div>
        </div>

        <!-- Narrative Column -->
        <div class="about-story-col">
          <h1 class="about-title">Making sense of complexity is deeply human work.</h1>
          
          <div class="about-paragraphs">
            {siteConfig.fullBio.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="about-actions">
            <Button href="/contact" variant="primary" size="md">
              Start a conversation
            </Button>
            <Button href="/work" variant="secondary" size="md">
              Explore case studies
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Career Journey Timeline / Squiggle Graphic -->
  <section class="section section-alt journey-section" aria-label="Career Journey and Milestones">
    <div class="container">
      <div class="section-intro">
        <h2 class="section-heading">The Squiggly Path: How Experience Shaped This Practice</h2>
        <p class="section-subtext">
          A career deliberately woven through grassroots community action, academic institutional leadership, and strategic corporate facilitation.
        </p>
      </div>

      <!-- Reusable Journey Squiggle Component -->
      <JourneySquiggle />
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section about-cta-section" aria-label="Get in Touch">
    <div class="container">
      <div class="about-cta-card">
        <h2 class="about-cta-title">Interested in exploring a collaboration?</h2>
        <p class="about-cta-sub">
          I regularly partner with higher education institutions, social impact enterprises, and forward-looking corporate leadership.
        </p>
        <div class="about-cta-btn-wrap">
          <Button href="/contact" variant="primary" size="lg">
            Get in touch directly
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero / Story */
  .about-hero-section {
    padding-top: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    padding-bottom: clamp(var(--space-10), 2rem + 3vw, var(--space-16));
    border-bottom: 1px solid var(--color-border);
    background: var(--gradient-ambient-hero);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    align-items: start;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(280px, 340px) 1fr;
    }
  }

  .about-photo-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .photo-frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-surface-tint);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-slow) var(--ease-spring),
                box-shadow var(--duration-slow) var(--ease-spring);
  }

  .photo-frame:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: var(--shadow-hover);
  }

  .about-portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .photo-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--space-2);
  }

  .detail-name {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-base);
    color: var(--color-text-main);
  }

  .detail-title {
    font-size: var(--font-size-xs);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
  }

  .detail-location {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .about-story-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
    line-height: var(--line-height-tight);
  }

  .about-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Section Intros */
  .section-intro {
    max-width: var(--container-narrow-width);
    margin-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .section-subtext {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Journey Section */
  .journey-section {
    border-bottom: 1px solid var(--color-border);
  }

  /* CTA Section */
  .about-cta-section {
    background-color: var(--color-bg);
  }

  .about-cta-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    text-align: center;
    box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--container-narrow-width);
    margin-left: auto;
    margin-right: auto;
    transition: box-shadow var(--duration-normal) var(--ease-spring);
  }

  .about-cta-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .about-cta-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .about-cta-sub {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 540px;
    line-height: var(--line-height-relaxed);
  }

  .about-cta-btn-wrap {
    margin-top: var(--space-2);
  }

  @media (max-width: 640px) {
    .about-photo-col {
      max-width: 260px;
      margin: 0 auto;
    }

    .about-actions {
      flex-direction: column;
      width: 100%;
    }

    .about-actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .about-cta-card {
      padding: var(--space-6) var(--space-4);
      border-radius: var(--radius-lg);
      text-align: left;
      align-items: flex-start;
    }

    .about-cta-btn-wrap {
      width: 100%;
    }

    .about-cta-btn-wrap :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
