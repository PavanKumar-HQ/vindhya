---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCaseSection from '../components/WorkCaseSection.astro';
import Button from '../components/Button.astro';
import { workCaseStudies } from '../data/workData';
---

<BaseLayout
  title="Selected Work & Case Studies — Vindhya Umapathy"
  description="Selected human-centred design initiatives across higher education transformation, grassroots community action, and enterprise innovation sprints."
>
  <!-- Page Header -->
  <section class="section work-header-section" aria-label="Work Introduction">
    <div class="container">
      <div class="work-header-content">
        <h1 class="page-title">Selected Work & Interventions</h1>
        <p class="page-lead">
          [TODO: replace with Vindhya's copy — selected engagements across higher education, grassroots communities, and executive facilitation]
        </p>
      </div>

      <!-- Top-of-Page Anchor Index (Sleek Index Register, not a generic card grid) -->
      <nav class="anchor-index-wrapper" aria-label="Case Study Quick Jump">
        <span class="index-label">Index of Engagements</span>
        <div class="index-register">
          {workCaseStudies.map((caseStudy, index) => (
            <a href={`#${caseStudy.id}`} class="index-register-item">
              <span class="index-num">0{index + 1}</span>
              <div class="index-meta">
                <span class="index-title">{caseStudy.shortTitle}</span>
                <span class="index-category">{caseStudy.category}</span>
              </div>
              <span class="index-arrow" aria-hidden="true">↓</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>

  <!-- Full-Width Content Blocks (Data-driven Editorial Layout) -->
  <div class="case-studies-container">
    {workCaseStudies.map((caseStudy, index) => (
      <WorkCaseSection caseStudy={caseStudy} index={index} />
    ))}
  </div>

  <!-- Closing Inquiries Banner -->
  <section class="section work-cta-section" aria-label="Initiate an Engagement">
    <div class="container">
      <div class="work-cta-card">
        <h2 class="work-cta-title">Facing an ambiguous challenge in your institution or product?</h2>
        <p class="work-cta-desc">
          Every project begins with a structured listening conversation. Let's discuss your team's context and outline what an intervention could look like.
        </p>
        <div class="work-cta-actions">
          <Button href="/contact" variant="primary" size="lg">
            Start a conversation
          </Button>
          <Button href="/services" variant="secondary" size="lg">
            Review service formats
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Header Section */
  .work-header-section {
    padding-top: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    padding-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .work-header-content {
    max-width: var(--container-narrow-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-3xl), 2rem + 2.5vw, var(--font-size-4xl));
    line-height: var(--line-height-tight);
    color: var(--color-text-main);
  }

  .page-lead {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Sleek Index Register */
  .anchor-index-wrapper {
    margin-top: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .index-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .index-register {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .index-register {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  .index-register-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-all);
  }

  .index-register-item:hover {
    border-color: var(--color-accent);
    background-color: var(--color-surface-tint);
    transform: translateY(-1px);
  }

  .index-num {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .index-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .index-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    line-height: var(--line-height-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .index-category {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: var(--line-height-snug);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .index-arrow {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-standard);
    flex-shrink: 0;
  }

  .index-register-item:hover .index-arrow {
    color: var(--color-accent);
    transform: translateY(2px);
  }

  /* Case Studies List */
  .case-studies-container {
    display: flex;
    flex-direction: column;
  }

  /* CTA Section */
  .work-cta-section {
    background-color: var(--color-bg);
  }

  .work-cta-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-8), 2rem + 3vw, var(--space-16));
    text-align: center;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--container-narrow-width);
    margin-left: auto;
    margin-right: auto;
  }

  .work-cta-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1vw, var(--font-size-3xl));
    color: var(--color-text-main);
  }

  .work-cta-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 580px;
    line-height: var(--line-height-relaxed);
  }

  .work-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
</style>
