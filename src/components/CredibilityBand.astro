---
import { siteConfig } from '../data/siteConfig';

export interface Props {
  headline?: string;
}

const {
  headline = "10+ years of designing for people, organisations, and systems"
} = Astro.props;
---

<section class="credibility-section" aria-label="Credibility and Impact">
  <div class="container">
    <div class="credibility-header">
      <h2 class="credibility-headline">{headline}</h2>
    </div>

    <!-- Stat Metric Grid -->
    <div class="stats-grid">
      {siteConfig.stats.map((stat) => (
        <div class="stat-item">
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
          {stat.detail && <span class="stat-detail">{stat.detail}</span>}
        </div>
      ))}
    </div>

    <!-- Partner & Institutional Experience Strip -->
    <div class="partners-wrapper">
      <span class="partners-label">Institutional Experience & Partnerships</span>
      <div class="partners-grid">
        {siteConfig.partners.map((partner) => (
          <div class="partner-card">
            <div class="partner-logo-placeholder">
              <span class="logo-placeholder-text">[Logo placeholder: {partner.name}]</span>
            </div>
            <div class="partner-info">
              <span class="partner-name">{partner.name}</span>
              <span class="partner-role">{partner.role}</span>
              <span class="partner-tagline">{partner.tagline}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .credibility-section {
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    padding-top: clamp(var(--space-12), 3rem + 3vw, var(--space-20));
    padding-bottom: clamp(var(--space-12), 3rem + 3vw, var(--space-20));
  }

  .credibility-header {
    max-width: var(--container-narrow-width);
    margin-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
  }

  .credibility-headline {
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    color: var(--color-accent-contrast);
    line-height: var(--line-height-tight);
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    padding-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  @media (min-width: 900px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-contrast);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-contrast);
    margin-top: var(--space-1);
  }

  .stat-detail {
    font-size: var(--font-size-xs);
    color: var(--color-text-inverted-muted);
    line-height: var(--line-height-snug);
  }

  /* Partners strip */
  .partners-wrapper {
    margin-top: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
  }

  .partners-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-6);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition: var(--transition-all);
  }

  .partner-logo-placeholder {
    padding: var(--space-2) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .logo-placeholder-text {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: var(--letter-spacing-wide);
  }

  .partner-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .partner-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-contrast);
  }

  .partner-role {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.85);
  }

  .partner-tagline {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
