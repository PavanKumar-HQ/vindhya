---
import { siteConfig } from '../data/siteConfig';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/\/$/, '') || '/';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo / Wordmark -->
    <a href="/" class="brand-link" aria-label={`${siteConfig.siteName} Home`}>
      <span class="brand-name">{siteConfig.siteName}</span>
      <span class="brand-title">Design Strategist & Facilitator</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        {siteConfig.navLinks.map((item) => {
          const itemClean = item.href.replace(/\/$/, '') || '/';
          const isActive = cleanPath === itemClean || (itemClean !== '/' && cleanPath.startsWith(itemClean));
          return (
            <li class="nav-item">
              <a 
                href={item.href} 
                class={`nav-link ${isActive ? 'nav-link--active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}

        {/* 
          ======================================================================
          NOTE FOR FUTURE DEVELOPER / CLIENT:
          Hidden route `/thinking` is intentionally excluded from the navigation.
          To make `/thinking` public in the navigation bar once essays are ready,
          uncomment the following list item:
          
          <li class="nav-item">
            <a href="/thinking" class={`nav-link ${cleanPath === '/thinking' ? 'nav-link--active' : ''}`}>
              Thinking
            </a>
          </li>
          ======================================================================
        */}
      </ul>
    </nav>

    <!-- Header CTA -->
    <div class="header-cta">
      <Button href="/contact" variant="primary" size="sm">
        Get in touch
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      type="button" 
      class="mobile-menu-toggle" 
      id="mobile-menu-toggle" 
      aria-expanded="false" 
      aria-controls="mobile-nav" 
      aria-label="Toggle navigation menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile Navigation" aria-hidden="true">
    <div class="mobile-nav-header">
      <span class="brand-name">{siteConfig.siteName}</span>
      <button 
        type="button" 
        class="mobile-close-btn" 
        id="mobile-close-btn" 
        aria-label="Close navigation menu"
      >
        ✕
      </button>
    </div>
    
    <ul class="mobile-nav-list">
      {siteConfig.navLinks.map((item) => {
        const itemClean = item.href.replace(/\/$/, '') || '/';
        const isActive = cleanPath === itemClean || (itemClean !== '/' && cleanPath.startsWith(itemClean));
        return (
          <li>
            <a 
              href={item.href} 
              class={`mobile-nav-link ${isActive ? 'mobile-nav-link--active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}

      {/* 
        NOTE: Hidden route `/thinking` is excluded from mobile navigation.
        Uncomment when published:
        <li>
          <a href="/thinking" class="mobile-nav-link">Thinking</a>
        </li>
      */}
    </ul>

    <div class="mobile-nav-footer">
      <Button href="/contact" variant="primary" size="md" class="mobile-cta-btn">
        Get in touch
      </Button>
      <p class="mobile-contact-note">{siteConfig.contactEmail}</p>
    </div>
  </nav>
</header>

<script>
  function setupNavBar() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-close-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');

    function openMenu() {
      if (!mobileNav || !toggleBtn || !backdrop) return;
      mobileNav.classList.add('is-open');
      backdrop.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
      mobileNav.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!mobileNav || !toggleBtn || !backdrop) return;
      mobileNav.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileNav.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav?.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Close mobile menu whenever a navigation occurs
    closeMenu();

    // Update active route highlight dynamically
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.nav-link, .mobile-nav-link').forEach((link) => {
      const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';
      const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
      if (isActive) {
        link.classList.add('nav-link--active', 'mobile-nav-link--active');
        link.setAttribute('aria-current', 'page');
      } else {
        link.classList.remove('nav-link--active', 'mobile-nav-link--active');
        link.removeAttribute('aria-current');
      }
    });
  }

  // Run on initial load and every Astro client-side page navigation
  document.addEventListener('astro:page-load', setupNavBar);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    background-color: rgba(250, 250, 250, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    transition: var(--transition-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Brand */
  .brand-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-md);
    color: var(--color-text-main);
    letter-spacing: var(--letter-spacing-snug);
  }

  .brand-title {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--letter-spacing-normal);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: var(--space-6);
  }

  .nav-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-1);
    position: relative;
    transition: var(--transition-color);
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link--active {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .nav-link--active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: var(--radius-full);
  }

  /* Header CTA */
  .header-cta {
    display: none;
  }

  @media (min-width: 900px) {
    .header-cta {
      display: block;
    }
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: var(--touch-target-min);
    height: var(--touch-target-min);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 768px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text-main);
    border-radius: 2px;
    transition: var(--transition-all);
  }

  /* Mobile Drawer */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-standard);
    z-index: 200;
  }

  .mobile-nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    background-color: var(--color-surface);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
    transform: translateX(100%);
    transition: transform var(--duration-slow) var(--ease-standard);
    z-index: 201;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  .mobile-nav.is-open {
    transform: translateX(0);
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-close-btn {
    background: transparent;
    border: none;
    font-size: var(--font-size-xl);
    width: var(--touch-target-min);
    height: var(--touch-target-min);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-secondary);
  }

  .mobile-nav-list {
    list-style: none;
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    padding: var(--space-3) 0;
    color: var(--color-text-main);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-nav-link--active {
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  .mobile-nav-footer {
    margin-top: auto;
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mobile-cta-btn {
    width: 100%;
  }

  .mobile-contact-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
