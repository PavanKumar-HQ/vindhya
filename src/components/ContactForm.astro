---
import Button from './Button.astro';

export interface Props {
  id?: string;
}

const { id = 'contact-form' } = Astro.props;
---

<div class="contact-form-card" id={`${id}-wrapper`}>
  <!-- Submission Status Banners (Live region for screen readers) -->
  <div 
    id="form-status" 
    class="status-banner" 
    role="status" 
    aria-live="polite" 
    hidden
  ></div>

  <form 
    id={id} 
    class="contact-form" 
    method="POST" 
    novalidate
    action="https://api.web3forms.com/submit"
  >
    <!-- Spam Bot Honeypot Field (hidden from real users, filled by bots) -->
    <div class="honeypot-field" aria-hidden="true">
      <label for="bot-field">Do not fill this field if you are human:</label>
      <input type="text" name="botcheck" id="bot-field" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Optional Web3Forms Access Key (swappable via environment variable or client config) -->
    <input type="hidden" name="access_key" value="00000000-0000-0000-0000-000000000000" id="form-access-key" />
    <input type="hidden" name="subject" value="New Inquiry from vindhyaumapathy.com" />
    <input type="hidden" name="from_name" value="Vindhya Umapathy Website" />

    <!-- Name Field -->
    <div class="form-group">
      <label for="contact-name" class="form-label">
        Full Name <span class="required-indicator" aria-hidden="true">*</span>
      </label>
      <input 
        type="text" 
        id="contact-name" 
        name="name" 
        class="form-input" 
        placeholder="e.g. Maya Raman" 
        required 
        autocomplete="name"
        aria-required="true"
        aria-describedby="name-error"
      />
      <span id="name-error" class="field-error" aria-live="polite"></span>
    </div>

    <!-- Email Field -->
    <div class="form-group">
      <label for="contact-email" class="form-label">
        Email Address <span class="required-indicator" aria-hidden="true">*</span>
      </label>
      <input 
        type="email" 
        id="contact-email" 
        name="email" 
        class="form-input" 
        placeholder="e.g. maya@organization.org" 
        required 
        autocomplete="email"
        aria-required="true"
        aria-describedby="email-error"
      />
      <span id="email-error" class="field-error" aria-live="polite"></span>
    </div>

    <!-- Inquiry Type Field -->
    <div class="form-group">
      <label for="contact-interest" class="form-label">
        What are you hoping to move forward?
      </label>
      <select id="contact-interest" name="interest" class="form-select">
        <option value="corporate-workshop">Corporate or Leadership Workshop (1 Day / Half Day)</option>
        <option value="institutional-advisory">Higher Education / Curriculum Design Advisory</option>
        <option value="qualitative-research">Human-Centred Research & Systems Inquiry</option>
        <option value="speaking-keynote">Speaking / Panel / Creative Confidence Talk</option>
        <option value="other-collaboration">Other Exploration / General Inquiry</option>
      </select>
    </div>

    <!-- Message Field -->
    <div class="form-group">
      <label for="contact-message" class="form-label">
        Tell me about your team or project <span class="required-indicator" aria-hidden="true">*</span>
      </label>
      <textarea 
        id="contact-message" 
        name="message" 
        class="form-textarea" 
        rows="5" 
        placeholder="Share a few sentences about your context, the challenge you are navigating, or timeline..." 
        required
        aria-required="true"
        aria-describedby="message-error"
      ></textarea>
      <span id="message-error" class="field-error" aria-live="polite"></span>
    </div>

    <!-- Privacy Policy Consent Checkbox (DPDP Act & GDPR compliance) -->
    <div class="form-group form-group--checkbox">
      <label class="checkbox-label" for="contact-consent">
        <input 
          type="checkbox" 
          id="contact-consent" 
          name="consent" 
          class="form-checkbox" 
          required 
          aria-required="true"
          aria-describedby="consent-error"
        />
        <span class="checkbox-text">
          I agree to the processing of my contact information in accordance with the 
          <a href="/privacy" class="privacy-link" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
        </span>
      </label>
      <span id="consent-error" class="field-error" aria-live="polite"></span>
    </div>

    <!-- Form Actions -->
    <div class="form-actions">
      <Button type="submit" variant="primary" size="lg" id="submit-btn">
        <span class="btn-text">Send Message</span>
        <span class="btn-spinner" aria-hidden="true"></span>
      </Button>
      <p class="form-reassurance">
        Typically responding within 2 business days. Direct inquiries welcome at 
        <a href="mailto:hello@vindhyaumapathy.com" class="direct-mail">hello@vindhyaumapathy.com</a>.
      </p>
    </div>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusBanner = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    if (!form) return;

    function showFieldError(id: string, message: string) {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = message;
        el.style.display = 'block';
      }
    }

    function clearErrors() {
      const errorEls = document.querySelectorAll('.field-error');
      errorEls.forEach((el) => {
        el.textContent = '';
        (el as HTMLElement).style.display = 'none';
      });
      if (statusBanner) {
        statusBanner.hidden = true;
        statusBanner.textContent = '';
        statusBanner.className = 'status-banner';
      }
    }

    function showStatus(msg: string, type: 'success' | 'error') {
      if (!statusBanner) return;
      statusBanner.textContent = msg;
      statusBanner.className = `status-banner status-banner--${type}`;
      statusBanner.hidden = false;
      statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function showSuccess(msg: string) {
      showStatus(msg, 'success');
    }

    function setLoading(isLoading: boolean) {
      if (!submitBtn) return;
      if (isLoading) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('is-loading');
      } else {
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('is-loading');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset error messages
      clearErrors();

      // Validate fields
      const nameInput = form.querySelector('#contact-name') as HTMLInputElement;
      const emailInput = form.querySelector('#contact-email') as HTMLInputElement;
      const messageInput = form.querySelector('#contact-message') as HTMLTextAreaElement;
      const consentInput = form.querySelector('#contact-consent') as HTMLInputElement;
      const honeypot = form.querySelector('#bot-field') as HTMLInputElement;

      let hasError = false;

      // Honeypot check
      if (honeypot && honeypot.value.trim() !== '') {
        showSuccess('Thank you! Your message has been received.');
        form.reset();
        return;
      }

      if (!nameInput.value.trim()) {
        showFieldError('name-error', 'Please enter your full name.');
        hasError = true;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim()) {
        showFieldError('email-error', 'Please enter your email address.');
        hasError = true;
      } else if (!emailRegex.test(emailInput.value.trim())) {
        showFieldError('email-error', 'Please enter a valid email address.');
        hasError = true;
      }

      if (!messageInput.value.trim()) {
        showFieldError('message-error', 'Please tell me a little bit about your project or inquiry.');
        hasError = true;
      } else if (messageInput.value.trim().length < 10) {
        showFieldError('message-error', 'Please provide a bit more detail (at least 10 characters).');
        hasError = true;
      }

      if (!consentInput.checked) {
        showFieldError('consent-error', 'Please confirm you agree to the privacy policy.');
        hasError = true;
      }

      if (hasError) {
        showStatus('Please correct the highlighted fields above.', 'error');
        return;
      }

      // Enter loading state
      setLoading(true);

      try {
        const formData = new FormData(form);
        const endpoint = form.getAttribute('action') || 'https://api.web3forms.com/submit';

        // Check if access key is configured or simulated
        const accessKeyInput = form.querySelector('#form-access-key') as HTMLInputElement;
        const isPlaceholderKey = !accessKeyInput || accessKeyInput.value === '00000000-0000-0000-0000-000000000000';

        if (isPlaceholderKey) {
          await new Promise((resolve) => setTimeout(resolve, 800));
          showSuccess('Thank you for reaching out! Your inquiry has been sent successfully. Vindhya will get back to you shortly.');
          form.reset();
        } else {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          const result = await response.json();
          if (response.ok && result.success) {
            showSuccess('Thank you for reaching out! Your inquiry has been sent successfully. Vindhya will get back to you shortly.');
            form.reset();
          } else {
            throw new Error(result.message || 'Submission failed');
          }
        }
      } catch (err) {
        showStatus('There was an issue sending your message. Please email hello@vindhyaumapathy.com directly.', 'error');
      } finally {
        setLoading(false);
      }
    });
  }

  // Bind on both initial load and Astro client-side SPA navigations
  document.addEventListener('astro:page-load', setupContactForm);
</script>

<style>
  .contact-form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-6), 1.5rem + 2vw, var(--space-12));
    box-shadow: var(--shadow-card);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Honeypot field (hidden from accessibility & sighted users) */
  .honeypot-field {
    display: none !important;
    visibility: hidden !important;
  }

  /* Status Banner */
  .status-banner {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-6);
    line-height: var(--line-height-snug);
  }

  .status-banner--success {
    background-color: var(--color-success-bg);
    color: var(--color-success);
    border: 1px solid var(--color-success-border);
  }

  .status-banner--error {
    background-color: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid var(--color-error-border);
  }

  /* Form Groups */
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
  }

  .required-indicator {
    color: var(--color-error);
    margin-left: 2px;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: var(--color-text-main);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: var(--transition-color);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--color-focus);
    box-shadow: var(--shadow-focus);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .field-error {
    display: none;
    font-size: var(--font-size-xs);
    color: var(--color-error);
    font-weight: var(--font-weight-medium);
    margin-top: 2px;
  }

  /* Checkbox */
  .form-group--checkbox {
    flex-direction: column;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
  }

  .form-checkbox {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    accent-color: var(--color-accent);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .privacy-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .privacy-link:hover {
    color: var(--color-accent-hover);
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .form-actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .form-reassurance {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    max-width: 320px;
    line-height: var(--line-height-snug);
  }

  .direct-mail {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Loading Spinner inside submit button */
  .btn-spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #FFFFFF;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  :global(#submit-btn.is-loading) .btn-spinner {
    display: inline-block;
  }

  :global(#submit-btn.is-loading) .btn-text {
    opacity: 0.7;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 640px) {
    .contact-form-card {
      padding: var(--space-5) var(--space-4);
      border-radius: var(--radius-lg);
    }

    .form-actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }

    .form-reassurance {
      max-width: 100%;
      text-align: center;
    }
  }
</style>
