---
// ScrollReveal.astro — Smooth, accessible scroll-reveal & counter engine with View Transitions support
---

<script>
  function setupScrollReveal() {
    // 1. Reading Progress Bar Engine
    const progressBar = document.getElementById('scroll-progress-bar');
    let ticking = false;

    function handleScroll() {
      const scrollY = window.scrollY;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;

      // Progress bar
      if (progressBar) {
        if (totalHeight > 0) {
          const progress = Math.min(100, Math.max(0, (scrollY / totalHeight) * 100));
          progressBar.style.width = `${progress}%`;
        } else {
          progressBar.style.width = '0%';
        }
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });

    handleScroll();

    // 2. Reduced Motion or Mobile Safety Check
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth <= 768;

    if (prefersReducedMotion || isMobile) {
      document.querySelectorAll('.reveal-item, [data-reveal]').forEach((el) => {
        el.classList.add('is-revealed');
      });
      // Still trigger counter numbers directly on mobile
      document.querySelectorAll('[data-counter-target]').forEach((c) => {
        animateCounter(c as HTMLElement);
      });
      return;
    }

    // 3. Numeric Counter Roll-Up Function
    function animateCounter(el: HTMLElement) {
      if (el.dataset.counterDone === 'true') return;
      el.dataset.counterDone = 'true';

      const rawTarget = el.getAttribute('data-counter-target') || el.textContent || '';
      const match = rawTarget.match(/^(\D*)(\d[\d,]*)(.*)$/);
      if (!match) return;

      const prefix = match[1] || '';
      const numStr = match[2].replace(/,/g, '');
      const suffix = match[3] || '';
      const targetNum = parseInt(numStr, 10);
      if (isNaN(targetNum)) return;

      const duration = 1200; // ms
      const startTime = performance.now();

      function update(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(1, elapsed / duration);
        // Exponential ease-out
        const ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
        const currentVal = Math.round(ease * targetNum);
        el.textContent = `${prefix}${currentVal.toLocaleString()}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          el.textContent = rawTarget;
        }
      }

      requestAnimationFrame(update);
    }

    // 4. Scroll Reveal Targets Selector
    const selector = [
      '.hero-text-block',
      '.hero-photo-placeholder',
      '.intro-photo-wrapper',
      '.intro-content',
      '.section-header-wrap',
      '.pathway-item',
      '.stat-item',
      '.partner-card',
      '.cta-inner',
      '.work-header-content',
      '.anchor-index-wrapper',
      '.case-header',
      '.case-card',
      '.service-panel-card',
      '.workshop-card',
      '.about-photo-col',
      '.about-story-col',
      '.journey-track-wrapper',
      '.milestone-entry',
      '.contact-form-card',
      '.info-card',
      '.faq-card',
      '.services-cta-banner',
      '.about-cta-card',
      '.work-cta-card'
    ].join(', ');

    const targets = Array.from(document.querySelectorAll(selector)) as HTMLElement[];
    if (!targets.length) return;

    const windowHeight = window.innerHeight;

    // IntersectionObserver for elements as you scroll down
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.classList.add('is-revealed');

            // Trigger any counters within this revealed block
            const counters = el.querySelectorAll('[data-counter-target]');
            counters.forEach((c) => animateCounter(c as HTMLElement));
            if (el.hasAttribute('data-counter-target')) {
              animateCounter(el);
            }

            observer.unobserve(el);
          }
        });
      },
      {
        root: null,
        threshold: 0.05,
        rootMargin: '0px 0px -20px 0px'
      }
    );

    // Differentiate elements above the fold vs below the fold
    const aboveFold: HTMLElement[] = [];
    const belowFold: HTMLElement[] = [];

    targets.forEach((el) => {
      el.classList.add('reveal-item');
      const rect = el.getBoundingClientRect();
      if (rect.top < windowHeight * 0.95 && rect.bottom > 0) {
        aboveFold.push(el);
      } else {
        belowFold.push(el);
        observer.observe(el);
      }
    });

    // Staggered reveal for above-the-fold elements upon page entrance
    aboveFold.forEach((el, index) => {
      setTimeout(() => {
        el.classList.add('is-revealed');
        const counters = el.querySelectorAll('[data-counter-target]');
        counters.forEach((c) => animateCounter(c as HTMLElement));
        if (el.hasAttribute('data-counter-target')) {
          animateCounter(el);
        }
      }, 40 + index * 60);
    });

    // Failsafe timer: Ensure all elements are revealed within 500ms so nothing can ever be stuck hidden
    setTimeout(() => {
      targets.forEach((el) => {
        if (!el.classList.contains('is-revealed')) {
          el.classList.add('is-revealed');
          const counters = el.querySelectorAll('[data-counter-target]');
          counters.forEach((c) => animateCounter(c as HTMLElement));
        }
      });
    }, 500);
  }

  // Bind to initial load and every Astro View Transitions navigation
  document.addEventListener('astro:page-load', setupScrollReveal);
</script>

<style is:global>
  /* --------------------------------------------------------------------------
     REFINED SCROLL REVEAL ANIMATIONS (DESKTOP)
     -------------------------------------------------------------------------- */
  .reveal-item {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Instant, robust visibility on mobile / iPhone to guarantee no blank content */
  @media (max-width: 768px) {
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* Natural staggered delay cascades for grid containers */
  .pathways-grid > .reveal-item:nth-child(1),
  .workshop-cards-grid > .reveal-item:nth-child(1),
  .case-cards-grid > .reveal-item:nth-child(1),
  .milestones-flow > .reveal-item:nth-child(1),
  .stats-grid > .reveal-item:nth-child(1),
  .partners-grid > .reveal-item:nth-child(1) {
    transition-delay: 50ms;
  }

  .pathways-grid > .reveal-item:nth-child(2),
  .workshop-cards-grid > .reveal-item:nth-child(2),
  .case-cards-grid > .reveal-item:nth-child(2),
  .milestones-flow > .reveal-item:nth-child(2),
  .stats-grid > .reveal-item:nth-child(2),
  .partners-grid > .reveal-item:nth-child(2) {
    transition-delay: 120ms;
  }

  .pathways-grid > .reveal-item:nth-child(3),
  .workshop-cards-grid > .reveal-item:nth-child(3),
  .case-cards-grid > .reveal-item:nth-child(3),
  .milestones-flow > .reveal-item:nth-child(3),
  .stats-grid > .reveal-item:nth-child(3) {
    transition-delay: 180ms;
  }

  .case-cards-grid > .reveal-item:nth-child(4) {
    transition-delay: 240ms;
  }

  /* Respect Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    #scroll-progress-bar {
      display: none !important;
    }
  }
</style>
