---
import type { WorkCaseStudy } from '../data/workData';

export interface Props {
  caseStudy: WorkCaseStudy;
  index: number;
}

const { caseStudy, index } = Astro.props;
const isAlt = index % 2 === 1;
---

<section 
  id={caseStudy.id} 
  class={`work-case-section ${isAlt ? 'work-case-section--alt' : ''}`}
  aria-labelledby={`case-title-${caseStudy.id}`}
>
  <div class="container">
    <!-- Header Block -->
    <div class="case-header">
      <div class="case-meta">
        <span class="case-category">{caseStudy.category}</span>
        <span class="case-sep">·</span>
        <span class="case-period">{caseStudy.period}</span>
      </div>
      <h2 id={`case-title-${caseStudy.id}`} class="case-title">{caseStudy.title}</h2>
      <p class="case-summary">{caseStudy.summary}</p>
    </div>

    <!-- 4 Distinct Cards Grid (Challenge, Approach, Scale, Outcome) -->
    <div class="case-cards-grid">
      <!-- 1. The Challenge Card -->
      <div class="case-card">
        <div class="card-step-header">
          <span class="step-eyebrow">01 · The Challenge</span>
        </div>
        <p class="card-body">{caseStudy.challenge}</p>
      </div>

      <!-- 2. The Approach Card -->
      <div class="case-card">
        <div class="card-step-header">
          <span class="step-eyebrow">02 · The Approach</span>
        </div>
        <p class="card-body">{caseStudy.approach}</p>
      </div>

      <!-- 3. Scale & Scope Card -->
      <div class="case-card">
        <div class="card-step-header">
          <span class="step-eyebrow">03 · Scale & Reach</span>
        </div>
        <p class="card-body">{caseStudy.scale}</p>
      </div>

      <!-- 4. Outcome Card -->
      <div class="case-card case-card--outcome">
        <div class="card-step-header">
          <span class="step-eyebrow">04 · The Outcome</span>
        </div>
        <p class="card-body">{caseStudy.outcome}</p>
      </div>
    </div>

    <!-- Tags footer -->
    <div class="case-footer">
      <span class="tags-label">Areas of Focus:</span>
      <div class="tags-list">
        {caseStudy.tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .work-case-section {
    padding-top: clamp(var(--space-12), 3rem + 3vw, var(--space-20));
    padding-bottom: clamp(var(--space-12), 3rem + 3vw, var(--space-20));
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .work-case-section--alt {
    background-color: var(--color-bg-alt);
  }

  /* Header */
  .case-header {
    max-width: var(--container-narrow-width);
    margin-bottom: clamp(var(--space-8), 2rem + 2vw, var(--space-12));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
  }

  .case-category {
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
  }

  .case-sep {
    color: var(--color-border-emphasis);
  }

  .case-period {
    color: var(--color-text-muted);
  }

  .case-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--font-size-2xl), 1.8rem + 1.2vw, var(--font-size-4xl));
    color: var(--color-text-main);
    line-height: var(--line-height-tight);
  }

  .case-summary {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* 4 Cards Grid */
  .case-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .case-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Content Cards */
  .case-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(var(--space-6), 1.5rem + 1vw, var(--space-8));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-all);
  }

  .case-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-emphasis);
  }

  .card-step-header {
    margin-bottom: var(--space-1);
  }

  .step-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
  }

  .card-body {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Outcome Card Subtle Emphasis */
  .case-card--outcome {
    background-color: var(--color-surface-tint);
    border-color: rgba(31, 43, 77, 0.18);
  }

  /* Footer tags */
  .case-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: clamp(var(--space-6), 1.5rem + 1vw, var(--space-8));
    padding-top: var(--space-4);
  }

  .tags-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-pill {
    font-size: var(--font-size-xs);
    background-color: var(--color-surface-tint);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-medium);
  }
</style>
