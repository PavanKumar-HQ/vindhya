---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  as: HeadingTag = 'h2',
  class: className = ''
} = Astro.props;
---

<div class={`section-header section-header--${align} ${className}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <HeadingTag class="title">{title}</HeadingTag>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(var(--space-8), 1.5rem + 2vw, var(--space-12));
    gap: var(--space-3);
  }

  .section-header--center {
    align-items: center;
    text-align: center;
  }

  .section-header--left {
    align-items: flex-start;
    text-align: left;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .title {
    color: var(--color-text-main);
    line-height: var(--line-height-tight);
  }

  .subtitle {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    max-width: var(--container-reading-width);
    line-height: var(--line-height-relaxed);
  }

  .section-header--center .subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: var(--space-6);
      gap: var(--space-2);
    }
  }
</style>
