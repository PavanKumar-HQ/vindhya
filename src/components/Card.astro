---
export interface Props {
  href?: string;
  variant?: 'default' | 'elevated' | 'tint' | 'outline' | 'interactive';
  padding?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'default',
  padding = 'md',
  class: className = '',
  id,
  ...rest
} = Astro.props;

const isLink = Boolean(href);
const Element = isLink ? 'a' : 'article';
---

<Element
  href={href}
  id={id}
  class={`card card--${variant} card--pad-${padding} ${isLink ? 'card--clickable' : ''} ${className}`}
  {...rest}
>
  <slot />
</Element>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-normal) var(--ease-spring),
                box-shadow var(--duration-normal) var(--ease-spring),
                border-color var(--duration-normal) var(--ease-standard),
                background-color var(--duration-normal) var(--ease-standard);
    text-decoration: none;
    color: inherit;
    position: relative;
    box-shadow: var(--shadow-subtle), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  /* Padding scales */
  .card--pad-sm {
    padding: var(--space-4);
  }

  .card--pad-md {
    padding: clamp(var(--space-6), 1.5rem + 1vw, var(--space-8));
  }

  .card--pad-lg {
    padding: clamp(var(--space-8), 2rem + 1.5vw, var(--space-12));
  }

  /* Variants */
  .card--default {
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .card--elevated {
    background-color: var(--color-surface);
    border-color: var(--color-border-subtle);
    box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .card--tint {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border-subtle);
  }

  .card--outline {
    background-color: transparent;
    border-color: var(--color-border);
  }

  /* Interactive / Clickable behavior */
  .card--clickable,
  .card--interactive {
    cursor: pointer;
  }

  .card--clickable:hover,
  .card--interactive:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-hover), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transform: translateY(-3px);
  }

  .card--clickable:active,
  .card--interactive:active {
    transform: translateY(0);
  }

  .card--clickable:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
</style>
