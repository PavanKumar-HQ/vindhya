---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <!-- Top Row: Brand & Inquiries -->
    <div class="footer-top">
      <div class="footer-brand">
        <h3 class="footer-name">{siteConfig.siteName}</h3>
        <p class="footer-tagline">{siteConfig.tagline}</p>
        <p class="footer-location">{siteConfig.location}</p>
      </div>

      <div class="footer-cta-col">
        <span class="footer-heading">Inquiries & Collaborations</span>
        <a href={`mailto:${siteConfig.contactEmail}`} class="footer-email-link">
          {siteConfig.contactEmail}
        </a>
        <p class="footer-avail-note">Open for consulting, institutional advisory, and workshop bookings.</p>
      </div>
    </div>

    <!-- Middle Row: Navigation & Socials -->
    <div class="footer-middle">
      <div class="footer-nav-col">
        <span class="footer-subheading">Navigation</span>
        <ul class="footer-links">
          {siteConfig.navLinks.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-nav-col">
        <span class="footer-subheading">Connect & Read</span>
        <ul class="footer-links">
          {siteConfig.socials.map((social) => (
            <li>
              <a 
                href={social.href} 
                class="footer-link" 
                target="_blank" 
                rel="noopener noreferrer"
              >
                {social.platform} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Row: Legal & Copyright -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {currentYear} {siteConfig.siteName}. All rights reserved.
      </p>

      <div class="footer-legal">
        <a href="/privacy" class="legal-link">Privacy Policy</a>
        <span class="legal-divider">·</span>
        <span class="legal-note">vindhyaumapathy.com</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding-top: clamp(var(--space-12), 2rem + 3vw, var(--space-20));
    padding-bottom: clamp(var(--space-8), 1.5rem + 2vw, var(--space-12));
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-8), 2rem + 2vw, var(--space-16));
  }

  /* Top Row */
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-name {
    font-family: var(--font-sans);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
  }

  .footer-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }

  .footer-location {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .footer-cta-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
  }

  .footer-email-link {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: var(--transition-color);
  }

  .footer-email-link:hover {
    color: var(--color-accent-hover);
  }

  .footer-avail-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    max-width: 380px;
  }

  /* Middle Row */
  .footer-middle {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer-middle {
      grid-template-columns: 200px 200px;
      justify-content: flex-start;
      gap: var(--space-12);
    }
  }

  .footer-subheading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-muted);
    display: block;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: var(--transition-color);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  /* Bottom Row */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legal-link {
    color: var(--color-text-muted);
    transition: var(--transition-color);
  }

  .legal-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .legal-divider {
    color: var(--color-border-emphasis);
  }
</style>
